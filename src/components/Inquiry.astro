<section class="inquiry" id="inquiry"><div class="inquiry-inner"><h2>专业地板，为您的空间而来</h2><p>告诉我们您的需求，一起寻找适合的地板方案。</p><form id="inquiry-form"><div class="form-row"><label>您的姓名<input name="name" autocomplete="name" required maxlength="50" placeholder="请输入姓名"/></label><label>联系方式<input name="contact" autocomplete="tel" required maxlength="100" placeholder="电话或电子邮箱"/></label></div><label>具体需求<textarea name="message" required maxlength="2000" rows="4" placeholder="产品类型、使用场景、预计面积等"></textarea></label><button type="submit">生成需求单</button><p class="form-note">生成后可下载需求单，方便后续联系。此表单暂未接入在线发送。</p><p id="form-status" role="status" aria-live="polite"></p></form></div></section>
<script>
document.querySelector<HTMLFormElement>('#inquiry-form')?.addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const data=new FormData(form);const name=String(data.get('name')||'').trim(),contact=String(data.get('contact')||'').trim(),message=String(data.get('message')||'').trim();if(!name||!contact||!message){document.querySelector('#form-status')!.textContent='请填写姓名、联系方式和具体需求。';return}const content=`万华机房 · 亿华地板 产品需求单\n姓名：${name}\n联系方式：${contact}\n具体需求：${message}\n`;const url=URL.createObjectURL(new Blob(['\ufeff'+content],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='万华地板-产品需求单.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);document.querySelector('#form-status')!.textContent='需求单已生成并下载，请保留文件用于后续联系。'});
</script>
