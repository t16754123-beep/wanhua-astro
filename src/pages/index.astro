---
import Layout from '../layouts/Layout.astro';
import Products from '../components/Products.astro';
import Inquiry from '../components/Inquiry.astro';
import intro from '../data/intro.txt?raw';
import {faq} from '../data/catalog.json';
const banners=['/Templates/cn/images/01.jpg','/Templates/cn/images/022.jpg'];
const advantages=[['专业研发，产品种类丰富','开发、研制和生产全钢防静电活动地板系列，涵盖全钢防静电高架活动地板、OA智能化高架活动地板、全钢陶瓷活动地板及多种配套产品。','201506301420159730'],['品质为根，诚信为本','进行标准化生产与管理，企业通过ISO质量体系认证，以优质的产品质量、合理的产品价格、良好的商业信誉、严格的企业管理赢得客户信赖。','wanhua-factory'],['携手合作，共谋发展','恪守“品质超卓、价格合理、服务周到”的理念，不断推陈出新，与国内外朋友携手合作，共谋发展，共创繁荣。','201506301423097598']];
const cases=['20150701150313234','201507011502072785','20150701150149795','201507011501151397','201507011500302456'];
---
<Layout active="/"><h1 class="sr-only">常州市万华机房设备有限公司 · 亿华活动地板</h1><section class="hero" aria-label="活动地板宣传展示" aria-roledescription="轮播"><div class="slides">{banners.map((src,i)=><img src={src} alt={['为数据中心和机房的发展保驾护航','品质与服务，赢得客户信赖','活动地板产品展示'][i]} class:list={{slide:true,current:i===0}} width="1920" height="600" fetchpriority={i===0?'high':undefined}/>)}</div><button class="hero-arrow prev" aria-label="上一张">‹</button><button class="hero-arrow next" aria-label="下一张">›</button><div class="hero-controls">{banners.map((_,i)=><button data-slide={i} class:list={{dot:true,current:i===0}} aria-label={`切换至第${i+1}张`} aria-pressed={i===0?'true':'false'}></button>)}<button class="pause" aria-label="暂停轮播">Ⅱ</button></div></section>
<section class="product"><div class="product_content"><h2 class="title font2">原料好，地板<span>质量</span>更有<span>保证</span></h2><p class="p_info">专业开发、研制和生产全钢防静电活动地板系列<br/>标准化生产与管理，以品质和诚信赢得客户信赖</p><Products compact/><a class="outline-more" href="/products.html">查看更多 ＋</a></div></section>
<section class="About"><div class="inner"><h2 class="title font2">关于万华<span></span></h2><div class="about-box"><div class="con about-box-left">{intro.trim().split(/\r?\n/).filter(Boolean).map(p=><p>{p}</p>)}</div><div class="about-box-right about-visual"><img src="/assets/logo.png" alt="亿华 YIHUA" width="260" height="156" loading="lazy"/><h3>常州市万华机房设备有限公司</h3><p>品质为根　诚信为本</p><div class="about-series"><span>全钢防静电地板</span><span>OA智能化地板</span><span>全钢陶瓷地板</span></div><a href="/about.html">了解更多 →</a></div></div></div></section>
<section class="advantage"><div class="inner"><h2 class="title font2">种类<span>丰富</span>，品质<span>可靠</span>，服务<span>周到</span></h2><ul>{advantages.map(([title,text,image],i)=><li class={`li${i+1}`}><div class="acon"><h3 class="titles font2"><span class="lf">{i+1}</span>{title}</h3><div class="con"><p>{text}</p></div></div><img src={`/upLoad/news/month_1506/${image}.jpg`} alt={title} class="imgs" width="600" height="284" loading="lazy"/></li>)}</ul></div></section>
<section class="client"><h2 class="title font2">活动地板 · 工程展示</h2><p class="client_info font2">品质超卓、价格合理、服务周到</p><ul>{cases.map((id,i)=><li class={i===4?'ri':'li1'}><a href="/cases.html"><img src={`/upLoad/album/month_1507/${id}.jpg`} alt={`工程场景参考 ${i+1}`} width="233" height="222" loading="lazy"/><span class="titles">工程场景参考 {i+1}</span></a></li>)}</ul><p class="reference-note">工程图片为参考站展示素材，非万华客户案例声明。</p><div class="mores"><a href="/cases.html" class="more_link">查看更多＋</a></div></section>
<section class="brand-banner"><h2>品质为根 · 诚信为本</h2><p>万华机房设备　与您携手共创繁荣</p><a href="/contact.html">了解产品与合作 →</a></section>
<section class="faq"><h2 class="title font2">常见问题解答<span></span></h2><div class="faq_list">{faq.map(f=><dl><dd><a href={f.url} class="font2 blue_link">{f.title}</a></dd><dt>{f.text}</dt></dl>)}</div><div class="mores"><a class="more_link" href="/news.html">查看更多＋</a></div></section><Inquiry/>
<section class="news"><h2 class="newstitle font2">地板资讯<span class="mores ri"><a href="/news.html">查看更多＋</a></span></h2><ul class="news_list">{faq.map((f,i)=><li><div class="news_2">0{i+1}<span>知识</span></div><div class="news_3"><span class="font2"><a href={f.url}>{f.title}</a></span><p>{f.text.slice(0,100)}…</p></div></li>)}</ul></section>
<script>
const hero=document.querySelector<HTMLElement>('.hero');if(hero){const slides=Array.from(hero.querySelectorAll('.slide'));const dots=Array.from(hero.querySelectorAll('.dot'));let current=0;let paused=matchMedia('(prefers-reduced-motion: reduce)').matches;let timer:ReturnType<typeof setInterval>|undefined;function show(i:number){current=(i+slides.length)%slides.length;slides.forEach((s,j)=>s.classList.toggle('current',j===current));dots.forEach((d,j)=>{d.classList.toggle('current',j===current);d.setAttribute('aria-pressed',String(j===current))})}function stop(){clearInterval(timer)}function start(){stop();if(!paused&&!document.hidden)timer=setInterval(()=>show(current+1),6000)}dots.forEach((d,i)=>d.addEventListener('click',()=>{show(i);start()}));hero.querySelector('.prev')?.addEventListener('click',()=>{show(current-1);start()});hero.querySelector('.next')?.addEventListener('click',()=>{show(current+1);start()});const pause=hero.querySelector('.pause')!;function updatePause(){pause.textContent=paused?'▶':'Ⅱ';pause.setAttribute('aria-label',paused?'播放轮播':'暂停轮播')}pause.addEventListener('click',()=>{paused=!paused;updatePause();start()});hero.addEventListener('mouseenter',stop);hero.addEventListener('mouseleave',start);hero.addEventListener('focusin',stop);hero.addEventListener('focusout',start);document.addEventListener('visibilitychange',start);updatePause();start();}
</script></Layout>
